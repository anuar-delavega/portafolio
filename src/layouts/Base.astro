---
import '../styles/global.css';
import { languages, useT, type Lang } from '../i18n/ui';
import { href, site } from '../site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta equivalente en el otro idioma (sin base), p. ej. "en/projects/democrm". */
  altPath: string;
  /** Muestra el preloader (solo la primera visita de la sesión al inicio). */
  intro?: boolean;
}

const { lang, title, description, altPath, intro = false } = Astro.props;
const t = useT(lang);
const pageTitle = title ? `${title} · ${site.name}` : t('meta.title');
const pageDesc = description ?? t('meta.description');
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const home = href(lang === 'es' ? '' : 'en');
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(href(altPath), Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05040A" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={alternate} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Unbounded:wght@400;600;800&display=swap"
    />
    {
      intro && (
        <script is:inline>
          try {
            if (!sessionStorage.getItem('intro-seen') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
              document.documentElement.classList.add('intro');
              sessionStorage.setItem('intro-seen', '1');
              // Seguro: si la animación no corre, el preloader nunca bloquea la página
              setTimeout(() => document.querySelector('.ld')?.remove(), 3500);
            }
          } catch (_) {}
        </script>
      )
    }
  </head>
  <body>
    <a class="sr-only skip" href="#main">Skip to content</a>

    {
      intro && (
        <div class="ld" aria-hidden="true">
          <div class="m ld-row"><span>{site.name}</span><span>{t('ld.year')}</span></div>
          <div style="display:flex;flex-direction:column;gap:20px">
            <div class="ld-n" />
            <div class="ld-bar" />
            <div class="m ld-row"><span>{t('ld.tagline')}</span><span>{t('ld.loading')}</span></div>
          </div>
        </div>
      )
    }

    <div class="prog" aria-hidden="true"></div>
    <div class="cur" aria-hidden="true"></div>
    <div class="curd" aria-hidden="true"></div>

    <nav class="nav" aria-label="Main">
      <a href={`${home}#inicio`} class="nlogo" aria-label={t('nav.home')}>AV</a>
      <a class="nl" href={`${home}#proyectos`}>{t('nav.projects')}</a>
      <a class="nl hide" href={`${home}#perfil`}>{t('nav.about')}</a>
      <a class="nl hide" href={`${home}#metodo`}>{t('nav.method')}</a>
      <a class="nl lang" href={href(altPath)} hreflang={otherLang} lang={otherLang} title={languages[otherLang]}>
        {otherLang.toUpperCase()}
      </a>
      <a class="btn bp sm" href={`${home}#contacto`} data-mag>{t('nav.contact')}</a>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="w m foot">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>{t('footer.city')}</span>
      <a href="#main">{t('footer.top')}</a>
    </footer>

    <script>
      import '../scripts/fx';
    </script>
  </body>
</html>
