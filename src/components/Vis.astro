---
/**
 * Visual animado del proyecto según categoría.
 * Si existe src/assets/covers/<slug>.(png|jpg|webp) se muestra la captura real.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  category: 'product' | 'tool' | 'automation' | 'web';
}
const { slug, title, category } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.{png,jpg,jpeg,webp}', { eager: true });
const shot = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === slug)?.[1].default;
---

{
  shot ? (
    <Image class="shot" src={shot} alt={title} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 800px" />
  ) : (
    <>
      <div class="vg" />
      {category === 'product' && <div class="bars">{Array.from({ length: 7 }, () => <i />)}</div>}
      {category === 'tool' && <div class="orb"><i /><i /><i /></div>}
      {category === 'automation' && (
        <div class="nodes">
          <svg viewBox="0 0 300 190" preserveAspectRatio="xMidYMid meet" fill="none">
            <path class="flow" d="M60 95 C110 40 150 40 150 95 S190 150 240 95" stroke="currentColor" stroke-width="2" style="color:var(--c3)" />
            <path class="flow" d="M60 95 L240 95" stroke="currentColor" stroke-width="1.5" style="color:var(--c2);opacity:.6" />
            <circle cx="60" cy="95" r="14" style="fill:var(--c1)" />
            <circle cx="150" cy="60" r="10" style="fill:var(--c2)" />
            <circle cx="150" cy="130" r="8" style="fill:var(--c3)" />
            <circle cx="240" cy="95" r="16" style="fill:var(--c2)" />
          </svg>
        </div>
      )}
      {category === 'web' && <div class="wins"><i /><i /></div>}
    </>
  )
}

<style>
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .vg {
    position: absolute; inset: 0;
    background-image: linear-gradient(var(--ln) 1px, transparent 1px), linear-gradient(90deg, var(--ln) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent); mask-image: linear-gradient(180deg, #000, transparent);
  }
  .bars { position: absolute; left: 28px; right: 28px; bottom: 26px; height: 60%; display: flex; align-items: flex-end; gap: 10px; }
  .bars i { flex: 1; border-radius: 8px 8px 3px 3px; background: linear-gradient(180deg, var(--c2), var(--c1)); animation: bar 2.4s ease-in-out infinite alternate; transform-origin: bottom; }
  .bars i:nth-child(1) { height: 40%; animation-delay: -0.2s; }
  .bars i:nth-child(2) { height: 70%; animation-delay: -0.8s; }
  .bars i:nth-child(3) { height: 52%; animation-delay: -1.4s; }
  .bars i:nth-child(4) { height: 88%; animation-delay: -0.5s; }
  .bars i:nth-child(5) { height: 62%; animation-delay: -1.1s; }
  .bars i:nth-child(6) { height: 96%; animation-delay: -1.7s; }
  .bars i:nth-child(7) { height: 74%; animation-delay: -0.3s; }
  @keyframes bar { from { transform: scaleY(0.45); } to { transform: scaleY(1); } }
  .orb { position: absolute; left: 50%; top: 50%; width: 150px; height: 150px; margin: -75px 0 0 -75px; }
  .orb i { position: absolute; inset: 0; border-radius: 50%; border: 1px solid var(--ln2); animation: rot 8s linear infinite; }
  .orb i:nth-child(2) { inset: 22px; border-color: color-mix(in oklab, var(--c3) 60%, transparent); animation-duration: 5s; animation-direction: reverse; }
  .orb i:nth-child(3) { inset: 48px; background: radial-gradient(circle, var(--c2), var(--c1)); border: 0; box-shadow: 0 0 50px var(--c2); animation: breathe 3s ease-in-out infinite; }
  .orb i:nth-child(1)::after, .orb i:nth-child(2)::after { content: ''; position: absolute; top: -5px; left: 50%; width: 10px; height: 10px; border-radius: 50%; background: var(--c3); box-shadow: 0 0 14px var(--c3); }
  @keyframes rot { to { transform: rotate(360deg); } }
  @keyframes breathe { 50% { transform: scale(1.15); } }
  .nodes { position: absolute; inset: 0; }
  .nodes svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .flow { stroke-dasharray: 6 8; animation: dash 1.2s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -28; } }
  .wins { position: absolute; inset: 0; }
  .wins i { position: absolute; width: 56%; height: 62%; border-radius: 12px; border: 1px solid var(--ln2); background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(6px); }
  .wins i::before { content: ''; position: absolute; top: 10px; left: 12px; width: 30px; height: 6px; border-radius: 3px; background: var(--ln2); }
  .wins i:nth-child(1) { left: 12%; top: 26%; animation: fl1 5s ease-in-out infinite; }
  .wins i:nth-child(2) { left: 30%; top: 16%; background: linear-gradient(140deg, color-mix(in oklab, var(--c1) 40%, transparent), rgba(255, 255, 255, 0.04)); animation: fl1 5s -2.5s ease-in-out infinite; }
  @keyframes fl1 { 50% { transform: translateY(-10px) rotate(-1.5deg); } }
</style>
