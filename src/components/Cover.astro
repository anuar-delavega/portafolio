---
/**
 * Portada del proyecto.
 * Si existe src/assets/covers/<slug>.(png|jpg|webp) se usa la captura real;
 * si no, se dibuja una ilustración abstracta según la categoría.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  category: 'product' | 'tool' | 'automation' | 'web';
  tall?: boolean;
  order?: number;
}
const { slug, title, category, tall = false, order = 0 } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.{png,jpg,jpeg,webp}', { eager: true });
const match = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === slug);
const shot = match?.[1].default;

// Tono por proyecto: ángulo áureo para que proyectos vecinos no se parezcan
const hue = Math.round((160 + order * 137.5) % 360);
---

<div class:list={['cover', { tall }]} style={`--h:${hue}`}>
  {
    shot ? (
      <Image src={shot} alt={title} widths={[480, 800, 1200]} sizes="(max-width: 720px) 100vw, 560px" />
    ) : (
      <div class="art" aria-hidden="true">
        <div class="win">
          <div class="win-bar"><i /><i /><i /></div>
          {category === 'product' && (
            <div class="dash">
              <div class="kpis"><b /><b /><b /></div>
              <div class="bars">{[42, 68, 55, 80, 62, 90, 74].map((v) => <span style={`height:${v}%`} />)}</div>
            </div>
          )}
          {category === 'tool' && (
            <div class="app">
              <div class="side"><b /><b /><b /><b /></div>
              <div class="main"><b class="w70" /><b class="w90" /><b class="w50" /><div class="prog"><span /></div></div>
            </div>
          )}
          {category === 'automation' && (
            <svg class="flow" viewBox="0 0 200 90">
              <path d="M30 45 C 70 45, 70 20, 100 20 M30 45 C 70 45, 70 70, 100 70 M100 20 C 130 20, 130 45, 170 45 M100 70 C 130 70, 130 45, 170 45" />
              <circle cx="30" cy="45" r="9" /><circle cx="100" cy="20" r="9" /><circle cx="100" cy="70" r="9" /><circle cx="170" cy="45" r="11" class="end" />
            </svg>
          )}
          {category === 'web' && (
            <div class="land">
              <b class="w60 big" /><b class="w80" /><b class="w40" />
              <div class="cols"><span /><span /><span /></div>
            </div>
          )}
        </div>
      </div>
    )
  }
</div>

<style>
  .cover {
    aspect-ratio: 16 / 9; overflow: hidden; position: relative;
    background:
      radial-gradient(120% 90% at 0% 0%, hsl(var(--h) 55% 78% / 0.9), transparent 60%),
      radial-gradient(100% 80% at 100% 100%, hsl(calc(var(--h) + 40) 50% 70% / 0.8), transparent 60%),
      hsl(var(--h) 30% 92%);
    border-bottom: 1px solid var(--line);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .cover {
      background:
        radial-gradient(120% 90% at 0% 0%, hsl(var(--h) 45% 30% / 0.9), transparent 60%),
        radial-gradient(100% 80% at 100% 100%, hsl(calc(var(--h) + 40) 40% 26% / 0.8), transparent 60%),
        hsl(var(--h) 18% 14%);
    }
  }
  :global(:root[data-theme='dark']) .cover {
    background:
      radial-gradient(120% 90% at 0% 0%, hsl(var(--h) 45% 30% / 0.9), transparent 60%),
      radial-gradient(100% 80% at 100% 100%, hsl(calc(var(--h) + 40) 40% 26% / 0.8), transparent 60%),
      hsl(var(--h) 18% 14%);
  }
  .tall { aspect-ratio: 21 / 9; border: 1px solid var(--line); border-radius: var(--radius); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .art { position: absolute; inset: 0; display: grid; place-items: end center; padding: 9% 12% 0; }
  .win {
    width: 100%; height: 100%; border-radius: 10px 10px 0 0;
    background: var(--surface); box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .win-bar { display: flex; gap: 5px; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .win-bar i { width: 7px; height: 7px; border-radius: 50%; background: var(--line); }
  b { display: block; height: 7px; border-radius: 4px; background: var(--surface-2); }
  .w40 { width: 40%; } .w50 { width: 50%; } .w60 { width: 60%; } .w70 { width: 70%; } .w80 { width: 80%; } .w90 { width: 90%; }
  .big { height: 12px; background: hsl(var(--h) 40% 60% / 0.5); }

  .dash { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 12px; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .kpis b { height: 22px; border-radius: 6px; }
  .kpis b:first-child { background: hsl(var(--h) 45% 55% / 0.35); }
  .bars { flex: 1; display: flex; align-items: flex-end; gap: 6%; padding: 0 4px; }
  .bars span { flex: 1; border-radius: 3px 3px 0 0; background: hsl(var(--h) 45% 50% / 0.55); }
  .bars span:nth-child(odd) { background: hsl(var(--h) 25% 60% / 0.35); }

  .app { flex: 1; display: grid; grid-template-columns: 28% 1fr; }
  .side { display: grid; align-content: start; gap: 8px; padding: 12px; background: var(--surface-2); }
  .side b { background: var(--line); }
  .side b:first-child { background: hsl(var(--h) 45% 55% / 0.5); }
  .main { display: grid; align-content: start; gap: 9px; padding: 14px; }
  .prog { height: 8px; border-radius: 4px; background: var(--surface-2); margin-top: 6px; overflow: hidden; }
  .prog span { display: block; width: 62%; height: 100%; background: hsl(var(--h) 50% 50% / 0.7); }

  .flow { flex: 1; width: 100%; padding: 6px 10px; }
  .flow path { fill: none; stroke: hsl(var(--h) 35% 55% / 0.6); stroke-width: 2.5; }
  .flow circle { fill: var(--surface-2); stroke: hsl(var(--h) 40% 50% / 0.8); stroke-width: 2.5; }
  .flow .end { fill: hsl(var(--h) 45% 55% / 0.6); }

  .land { flex: 1; display: grid; align-content: start; gap: 9px; padding: 16px 14px; }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px; }
  .cols span { height: 34px; border-radius: 6px; background: var(--surface-2); }
</style>
