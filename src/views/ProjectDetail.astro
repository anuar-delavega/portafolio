---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import { useT, projectsSegment, type Lang } from '../i18n/ui';
import { href } from '../site';

interface Props { lang: Lang; project: CollectionEntry<'projects'> }
const { lang, project } = Astro.props;
const t = useT(lang);
const d = project.data;
const slug = project.id.split('/').pop()!;
const { Content } = await render(project);

const all = (await getCollection('projects', (p) => p.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];
const nextSlug = next.id.split('/').pop()!;

const prefix = (l: Lang) => (l === 'es' ? '' : 'en/');
const other: Lang = lang === 'es' ? 'en' : 'es';
const altPath = `${prefix(other)}${projectsSegment[other]}/${slug}`;
const home = href(lang === 'es' ? '' : 'en');
---

<Base lang={lang} title={d.title} description={d.tagline} altPath={altPath}>
  <article class="container detail">
    <a class="back" href={`${home}#proyectos`}>← {t('project.back')}</a>

    <header class="head">
      <div class="meta">
        <span class:list={['badge', `badge--${d.status}`]}>{t(`status.${d.status}`)}</span>
        <span>·</span>
        <span>{t(`category.${d.category}`)}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>
      <div class="ctas">
        {d.demo && <a class="btn btn--primary" href={d.demo} target="_blank" rel="noopener">{t('project.demo')} ↗</a>}
        {d.repo && <a class="btn" href={d.repo} target="_blank" rel="noopener">{t('project.repo')} ↗</a>}
        {!d.repo && <span class="private">🔒 {t('project.private')}</span>}
      </div>
    </header>

    <Cover slug={slug} title={d.title} category={d.category} order={d.order} tall />

    <div class="layout">
      <aside class="facts">
        <dl>
          <div><dt>{t('project.role')}</dt><dd>{d.role}</dd></div>
          <div><dt>{t('project.period')}</dt><dd>{d.period}</dd></div>
          <div>
            <dt>{t('project.stack')}</dt>
            <dd><ul class="stack">{d.stack.map((s) => <li class="chip">{s}</li>)}</ul></dd>
          </div>
        </dl>
        {d.metrics.length > 0 && (
          <div class="metrics">
            {d.metrics.map((m) => (
              <div><strong>{m.value}</strong><span>{m.label}</span></div>
            ))}
          </div>
        )}
      </aside>

      <div class="content">
        <section class="highlights">
          <h2>{t('project.highlights')}</h2>
          <ul>{d.highlights.map((h) => <li>{h}</li>)}</ul>
        </section>
        <div class="prose"><Content /></div>
        {d.credit && <p class="credit">{d.credit}</p>}
      </div>
    </div>

    <a class="next" href={href(`${prefix(lang)}${projectsSegment[lang]}/${nextSlug}`)}>
      <span>{t('project.next')}</span>
      <strong>{next.data.title} →</strong>
    </a>
  </article>
</Base>

<style>
  .detail { padding-block: 32px 80px; display: grid; gap: 32px; }
  .back { color: var(--ink-3); text-decoration: none; font-size: 0.9rem; }
  .back:hover { color: var(--ink); }
  .head { display: grid; gap: 14px; max-width: 760px; }
  .meta { display: flex; gap: 8px; align-items: center; color: var(--ink-3); font-size: 0.85rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  .tagline { font-size: 1.2rem; color: var(--ink-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 6px; }
  .private { font-size: 0.88rem; color: var(--ink-3); }

  .layout { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 56px; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; gap: 32px; } }
  .facts { position: sticky; top: 88px; display: grid; gap: 20px; }
  @media (max-width: 860px) { .facts { position: static; } }
  .facts dl { margin: 0; display: grid; gap: 18px; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .facts dt { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px; }
  .facts dd { margin: 0; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0; list-style: none; }
  .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .metrics div { background: var(--surface); padding: 14px 16px; display: grid; }
  .metrics strong { font-family: var(--font-display); font-size: 1.6rem; font-weight: 500; line-height: 1.1; }
  .metrics span { font-size: 0.8rem; color: var(--ink-3); }

  .content { display: grid; gap: 40px; max-width: 70ch; }
  .highlights h2, .prose :global(h2) { font-size: 1.6rem; margin-bottom: 14px; }
  .highlights ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .highlights li { position: relative; padding-left: 26px; }
  .highlights li::before { content: ''; position: absolute; left: 4px; top: 0.6em; width: 9px; height: 9px; border-radius: 3px; background: var(--accent); }
  .prose { display: grid; gap: 16px; color: var(--ink-2); font-size: 1.04rem; }
  .prose :global(h2) { color: var(--ink); margin: 16px 0 0; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(ul) { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; background: var(--surface-2); padding: 1px 6px; border-radius: 5px; }
  .credit { font-size: 0.88rem; color: var(--ink-3); padding: 14px 16px; border-left: 3px solid var(--line); background: var(--surface); border-radius: 0 8px 8px 0; }

  .next {
    display: grid; gap: 4px; padding: 24px 28px; margin-top: 24px; text-decoration: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    transition: border-color 0.2s ease;
  }
  .next:hover { border-color: var(--ink-3); }
  .next span { font-size: 0.82rem; color: var(--ink-3); }
  .next strong { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; }
</style>
